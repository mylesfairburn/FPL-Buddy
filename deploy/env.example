# Copy to `.env` NEXT TO docker-compose.yml on the server, then fill in.
# Compose reads `.env` from its own directory automatically - so if the stack
# lives in /root/apps, the file is /root/apps/.env.
#
#   chmod 600 .env
#
# This example file is committed. `.env` itself must NEVER be - it is in
# .gitignore, and it holds live credentials.

# --- Required ---------------------------------------------------------------

# Gates /api/refresh, which triggers a full pipeline run and drives DB writes.
#   openssl rand -hex 32 > /srv/fpl-companion/refresh_token
FPL_REFRESH_TOKEN=

# --- Optional --------------------------------------------------------------

# Served back as /<key>.txt to prove ownership to IndexNow. Not a secret - it
# is deliberately published - but it lives here so the compose file is the same
# on every machine.
FPL_INDEXNOW_KEY=

# Lets the generated post drafts be read from a phone. The secret is the URL
# itself, so treat it like a password even though what it protects is only
# draft post text.
#   openssl rand -hex 32
#
# Four things live under it:
#   /api/social/<key>/latest           this gameweek's briefing drafts
#   /api/social/<key>/roundup          the last gameweek's roundup drafts
#   /api/social/<key>/player/latest    tonight's player write-up   <- bookmark this
#   /api/social/<key>/player           every player write-up still on disk
FPL_SOCIAL_KEY=

# --- Alerting ---------------------------------------------------------------

# Where to push a message when a scheduled job fails or falls behind.
#
# This is the only part of the system that reaches OUT rather than waiting to
# be asked, and on a project with one maintainer it is the difference between
# finding out on the night and finding out when the site has been stale for a
# week. Unset, nothing is ever sent and nothing complains about it.
#
# A Discord webhook (Server Settings -> Integrations -> Webhooks) is the
# easiest; an ntfy topic URL or a Slack incoming webhook also work. The format
# is detected from the URL, so there is normally nothing else to set.
FPL_ALERT_WEBHOOK=

# Three more channels. Each falls back to FPL_ALERT_WEBHOOK when unset, so
# setting only the one above puts everything in a single channel and these can
# be split out one at a time later.
#
# Worth splitting, because they want different notification settings on a
# phone: alerts should buzz at 3am, content should be waiting in the morning,
# seo is a weekly read. One channel carrying all four ends up muted, which is
# the same as having none of them.

# Post drafts, pushed at the moment they become worth posting:
#   - the nightly player write-up, every morning
#   - the gameweek briefing, about a day before each deadline
#   - the gameweek roundup, once the round is settled
# Each carries the Discord-length version plus a link to the full drafts.
FPL_DRAFTS_WEBHOOK=

# Deadline reminders (about a day out, and again about two hours out), and a
# message when the AI Manager commits its squad showing the transfers it took,
# any hit it ate and any chip it played.
FPL_GAMEWEEK_WEBHOOK=

# The weekly Search Console / Bing digest: clicks, impressions, average
# position, what is bringing clicks, and what is ranking but not being clicked.
# Sent on the first run of each ISO week.
FPL_SEO_WEBHOOK=

# --- Ko-fi ------------------------------------------------------------------

# Ko-fi donations, relayed into Discord.
#
# Ko-fi can POST to any URL but cannot post to Discord directly - Discord wants
# its own JSON shape - so POST /api/kofi on this site does the translation, and
# strips the donor's email address on the way, which Ko-fi includes in every
# payload and which has no business in a chat channel.
#
# Set BOTH of these or neither. The route does not exist without the token.
#
# 1. Ko-fi -> Settings -> API / Webhooks. Set the webhook URL to:
#       https://fpl.mfhost.co.uk/api/kofi
#    and copy the Verification Token shown on that page into FPL_KOFI_TOKEN.
# 2. Make a Discord webhook for the channel you want donations in, and put it
#    in FPL_KOFI_WEBHOOK.
#
# The token is what stands between this endpoint and anyone who finds the URL,
# since Ko-fi's servers cannot authenticate. Treat it as a password.
FPL_KOFI_TOKEN=
FPL_KOFI_WEBHOOK=

# Override the detection above if you are posting somewhere unusual:
#   discord | slack | text
# "text" POSTs the message as a plain body, which is what ntfy and most simple
# receivers want. It applies to every channel.
FPL_ALERT_FORMAT=

# --- Search Console / Bing reporting ---------------------------------------

# A PATH to the Google service-account JSON, not the key itself. The file is
# mounted read-only at /app/secrets by docker-compose.yml.
#
# Getting it: Google Cloud console -> enable the Search Console API -> create a
# service account -> add a JSON key -> copy that file to
# /srv/fpl-companion/secrets/gsc.json (chmod 600).
#
# Then the step that is easy to miss: open the JSON, take the `client_email`
# value, and add it as a FULL user in Search Console -> Settings -> Users and
# permissions. Creating the service account grants it nothing on its own.
GSC_KEY=/app/secrets/gsc.json

# How Search Console identifies the property, which is NOT the site's own URL.
# Leaving this unset defaults it to https://fpl.mfhost.co.uk/ - a URL-prefix
# property - and this site is verified as a DOMAIN property instead, so every
# request 403s and the nightly report lands with the Google half missing and
# the Bing half fine. That is a quiet failure: the file is still written, still
# the right size, and still has a `gsc` key in it.
#
# There are two properties on this account and only one of them is the site:
#   sc-domain:fpl.mfhost.co.uk   <- this site
#   sc-domain:mfhost.co.uk       <- the parent domain, everything under it
#
# `python seo_report.py --diagnose` prints every property the service account
# can see, copied exactly, and is the fastest way to settle this after any
# change to the domain or the account.
GSC_PROPERTY=sc-domain:fpl.mfhost.co.uk

# Bing Webmaster Tools -> Settings -> API access -> generate. A short opaque
# string, so unlike the Google credential it is fine as an env value.
BINGWEBMASTER_KEY=

# Google Cloud API key with the PageSpeed Insights API enabled - an ordinary
# API key, not the service account above. Optional: without it the report is
# written with its Core Web Vitals section skipped rather than failing.
#
# Each of the four pages is a separate call taking 10-30 seconds, which is why
# the job runs at 04:00 with nothing waiting on it.
PSI_KEY=
