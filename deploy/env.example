# Copy to `.env` NEXT TO docker-compose.yml on the server, then fill in.
# Compose reads `.env` from its own directory automatically - so if the stack
# lives in /root/apps, the file is /root/apps/.env.
#
#   chmod 600 .env
#
# This example file is committed. `.env` itself must NEVER be - it is in
# .gitignore, and it holds live credentials.

# --- Required ---------------------------------------------------------------

# Gates /api/refresh, which triggers a full pipeline run and drives DB writes.
#   openssl rand -hex 32 > /srv/fpl-companion/refresh_token
FPL_REFRESH_TOKEN=

# --- Optional --------------------------------------------------------------

# Served back as /<key>.txt to prove ownership to IndexNow. Not a secret - it
# is deliberately published - but it lives here so the compose file is the same
# on every machine.
FPL_INDEXNOW_KEY=

# Lets the weekly social drafts be read from a phone, at
# /api/social/<key>/latest. The secret is the URL itself, so treat it like a
# password even though what it protects is only draft post text.
#   openssl rand -hex 32
FPL_SOCIAL_KEY=

# --- Search Console / Bing reporting ---------------------------------------

# A PATH to the Google service-account JSON, not the key itself. The file is
# mounted read-only at /app/secrets by docker-compose.yml.
#
# Getting it: Google Cloud console -> enable the Search Console API -> create a
# service account -> add a JSON key -> copy that file to
# /srv/fpl-companion/secrets/gsc.json (chmod 600).
#
# Then the step that is easy to miss: open the JSON, take the `client_email`
# value, and add it as a FULL user in Search Console -> Settings -> Users and
# permissions. Creating the service account grants it nothing on its own.
GSC_KEY=/app/secrets/gsc.json

# How Search Console identifies the property, which is NOT the site's own URL.
# Leaving this unset defaults it to https://fpl.mfhost.co.uk/ - a URL-prefix
# property - and this site is verified as a DOMAIN property instead, so every
# request 403s and the nightly report lands with the Google half missing and
# the Bing half fine. That is a quiet failure: the file is still written, still
# the right size, and still has a `gsc` key in it.
#
# There are two properties on this account and only one of them is the site:
#   sc-domain:fpl.mfhost.co.uk   <- this site
#   sc-domain:mfhost.co.uk       <- the parent domain, everything under it
#
# `python seo_report.py --diagnose` prints every property the service account
# can see, copied exactly, and is the fastest way to settle this after any
# change to the domain or the account.
GSC_PROPERTY=sc-domain:fpl.mfhost.co.uk

# Bing Webmaster Tools -> Settings -> API access -> generate. A short opaque
# string, so unlike the Google credential it is fine as an env value.
BINGWEBMASTER_KEY=

# Google Cloud API key with the PageSpeed Insights API enabled - an ordinary
# API key, not the service account above. Optional: without it the report is
# written with its Core Web Vitals section skipped rather than failing.
#
# Each of the four pages is a separate call taking 10-30 seconds, which is why
# the job runs at 04:00 with nothing waiting on it.
PSI_KEY=
