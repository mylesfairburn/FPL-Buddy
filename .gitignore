.git
__pycache__/
LAUNCH-REPORT.md
tests/reports/
*.pyc
.venv/
venv/
build/
.vscode/
# Live credentials. `deploy/env.example` is the committed template; the real
# .env lives beside docker-compose.yml on the server and holds the refresh
# token, the Bing API key and the social-drafts key. secrets/ is where the
# Google service-account JSON goes - that file contains an RSA private key.
.env
.env.*
!deploy/env.example
secrets/

# Somewhere to drop exports for analysis - Lighthouse JSON, Search Console and
# Bing CSVs, whatever else. Deliberately untracked: they are point-in-time
# dumps that go stale, several are large, and the Search Console exports carry
# query data that doesn't belong in a public repo. Keep the folder, ignore the
# contents.
reports/*
!reports/.gitkeep

# SQLite state — lives on a mounted volume in production, never in the image
state/
*.db
*.db-wal
*.db-shm

# Live API cache - rewritten on every fetch, not source data
data/seasons/*/bootstrap.json

# Trained model bundles. Deliberately unpublished: they're the one part of this
# project that can't be rebuilt from public data in an afternoon. They live on
# the deployment's data volume instead (FPL_DATA_ROOT -> /srv/fpl-companion/data
# in production), and `python train_model.py` regenerates them locally.
#
# Keep a backup somewhere that is neither this repo nor that one server.
data/models/*.pkl
